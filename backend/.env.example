# Copy to backend/.env and adjust. Real environment variables take precedence.

# MongoDB must run as a replica set: transfers use multi-document transactions.
# Local single-node replica set (see README):
MONGODB_URI=mongodb://127.0.0.1:27017/paytm?replicaSet=rs0
# MongoDB Atlas (clusters are replica sets):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/paytm

# Secret used to sign JWTs (at least 16 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

PORT=3000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# Random starting balance for new accounts, in rupees
SIGNUP_BONUS_MIN=1000
SIGNUP_BONUS_MAX=10000
